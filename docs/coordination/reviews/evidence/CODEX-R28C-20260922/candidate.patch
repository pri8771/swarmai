+@pytest.mark.integration
+@pytest.mark.asyncio
+async def test_legacy_exactly_once_across_fresh_gateway_instances(factory) -> None:
+    calls = {"count": 0}
+
+    def handler(args):
+        calls["count"] += 1
+        return {"outcome": "succeeded", "external_id": f"synthetic-{calls['count']}"}
