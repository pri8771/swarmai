{
  "spec_of": "prompt",
  "identity": {
    "prompt_id": "g13-prompt-v2",
    "system_prompt_present": false,
    "exemplars": 0,
    "model_visible_record_keys": ["input"],
    "record_key_allowlist": [
      "family",
      "generation",
      "hidden_reference",
      "id",
      "input",
      "output_limit_tokens_proposed",
      "pool",
      "product_family",
      "scenario",
      "schema_version",
      "size",
      "split",
      "variant"
    ],
    "input_key_allowlist": [
      "constraints",
      "dependencies",
      "distractors",
      "instruction",
      "items",
      "output_contract",
      "question",
      "signature",
      "task"
    ],
    "answer_key_denylist": [
      "answer",
      "answers",
      "broken_code",
      "expected",
      "expected_output",
      "gold",
      "gold_answer",
      "grader",
      "grading",
      "hidden_answer",
      "hidden_output",
      "holdout_label",
      "label",
      "reference",
      "reference_output",
      "reference_solution",
      "rubric",
      "solution",
      "target",
      "test_cases",
      "unit_tests"
    ],
    "leakage_policy": "refuse_not_sanitise",
    "section_order": [
      "TASK",
      "INSTRUCTION",
      "QUESTION",
      "SIGNATURE",
      "ITEMS",
      "DEPENDENCIES",
      "CONSTRAINTS",
      "DISTRACTORS",
      "OUTPUT CONTRACT"
    ],
    "digest_algorithm": "sha256",
    "payload_digest_input": "json.dumps({'input': visible}, sort_keys=True, separators=(',',':'), ensure_ascii=True) encoded utf-8",
    "prompt_digest_input": "render_prompt(visible) encoded utf-8",
    "trailing_newline": true
  },
  "implementation_module": "src/swarm/evals/g13_prompt_v2.py",
  "mirror_assertion": "this spec .identity block equals swarm.evals.g13_prompt_v2.prompt_identity(), asserted by tests/evals/test_task_pool_freeze_v2.py",
  "why_refuse_not_sanitise": "v1 built the model input with a defensive copy that stripped leakage keys. That lets a contaminated record through in sanitised form, so the contamination survives in the committed corpus. In v2 a contaminated record cannot produce a payload at all and the freeze fails.",
  "no_tool_description_in_prompt": true,
  "tool_protocol_binding": "g13-tool-protocol-v2-no-model-visible-tools"
}
