# SwarmAI local compose secrets — V2A-H6A
# Copy to deploy/compose/.env (gitignored) or run:
#   python scripts/generate_compose_env.py
#
# Operational default is EMPTY / unconfigured. Do not commit real secrets.
# Fixed demo password "swarm" is forbidden for normal-mode compose.

# Required for standalone/hybrid/recovery:
SWARM_POSTGRES_USER=swarm
SWARM_POSTGRES_PASSWORD=
SWARM_POSTGRES_DB=swarm

# In-compose DSN uses the db service hostname (password must match above):
SWARM_DATABASE_URL=

# API bind remains loopback/private (compose also hard-codes 127.0.0.1:8765):
SWARM_BIND_HOST=127.0.0.1
