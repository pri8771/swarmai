# EXAMPLE ONLY — copy to mac-connector.env (gitignored).
# Portable twin: deploy/env/worker-connector.env.example
# REFERENCE Mac notes: docs/reference/MAC-CONNECTOR.md

SWARM_ALLOW_PAID=false
SWARM_SECRET_BACKEND=environment

# Connector → server base URL (loopback or private). Compose may use host.docker.internal.
SWARM_SERVER_URL=http://127.0.0.1:8765

# Loopback operator token for local verify only — copy from server.env, never commit.
# SWARM_SEED_LOOPBACK_TOKEN=
# SWARM_API_AUTH_TOKEN=
