# EXAMPLE ONLY — outbound worker connector (gitignored after copy).
# Profile doctor name remains mac_connector (historical); this file is portable.

SWARM_ALLOW_PAID=false
SWARM_ALLOW_PROVIDER_NETWORK=false
SWARM_SECRET_BACKEND=environment

# Server API base reachable from this worker (loopback, LAN, or private DNS).
SWARM_SERVER_URL=http://127.0.0.1:8765

# Copy seed/auth token from the server install — never commit.
# SWARM_SEED_LOOPBACK_TOKEN=
# SWARM_API_AUTH_TOKEN=
