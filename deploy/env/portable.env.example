# EXAMPLE ONLY — portable server/standalone overlay.
# Copy to portable.env or server.env (gitignored). Never commit filled secrets.

# Required for non-mock API identity bootstrap (loopback seed).
SWARM_SEED_LOOPBACK_TOKEN=replace-with-long-random-token

# Optional explicit API bearer (if used by install).
# SWARM_API_AUTH_TOKEN=

SWARM_ALLOW_PAID=false
SWARM_ALLOW_PROVIDER_NETWORK=false
SWARM_EXECUTION_MODE=standalone
SWARM_SECRET_BACKEND=environment

# Compose substitutes this into the DB URL; use a local random password.
SWARM_PG_PASSWORD=replace-with-local-random-password

# Placeholder public identity — replace only in runtime config when real DNS+auth exist.
SWARM_PUBLIC_HOSTNAME=coordinator.example.test
SWARM_API_BASE_URL=https://coordinator.example.test
# SWARM_PUBLIC_BASE_URL=https://edge.example.test

# Host loopback publish (override if the port is busy).
SWARM_HOST_PORT=8765
SWARM_BIND_HOST=0.0.0.0
SWARM_PORT=8765
