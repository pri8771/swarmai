# EXAMPLE ONLY — product compose (console + api + worker + postgres).
# Copy to product.env (gitignored). Never commit filled secrets.

SWARM_SEED_LOOPBACK_TOKEN=replace-with-long-random-token
# Worker/console auth against API — same value as seed for loopback product stack.
SWARM_API_AUTH_TOKEN=replace-with-long-random-token
SWARM_PG_PASSWORD=replace-with-local-random-password

SWARM_ALLOW_PAID=false
SWARM_ALLOW_PROVIDER_NETWORK=false
SWARM_EXECUTION_MODE=standalone
SWARM_SECRET_BACKEND=environment

# Placeholder identity — replace only when real DNS+auth exist.
SWARM_PUBLIC_HOSTNAME=coordinator.example.test
SWARM_WORKER_HOSTNAME=worker.example.local

# Host loopback publish (override if ports collide).
SWARM_HOST_PORT=8765
SWARM_CONSOLE_HOST_PORT=43127
SWARM_BIND_HOST=0.0.0.0
SWARM_PORT=8765

# Optional: bound worker connector smoke loops (omit for forever-running).
# SWARM_CONNECTOR_MAX_ITERATIONS=3
# SWARM_CONNECTOR_POLL=1.0
