# EXAMPLE ONLY — copy to server.env (gitignored) and fill locally.
# Never commit real tokens or passwords.

# Required for non-mock API identity bootstrap (loopback seed).
SWARM_SEED_LOOPBACK_TOKEN=replace-with-long-random-token

# Optional explicit API bearer (if used by install).
# SWARM_API_AUTH_TOKEN=

SWARM_ALLOW_PAID=false
SWARM_ALLOW_PROVIDER_NETWORK=false
SWARM_EXECUTION_MODE=standalone

# Compose substitutes this into the DB URL; change for non-local hosts.
SWARM_PG_PASSWORD=swarm

# Public hostname is DNS/config — not used until Cloudflare tunnel profile is enabled.
SWARM_PUBLIC_HOSTNAME=swarm.splitsignal.ai
# Host loopback publish for Mac verify (container still listens on 8765).
SWARM_HOST_PORT=18766
