{
  "$defs": {
    "Modality": {
      "enum": [
        "text",
        "code",
        "image",
        "audio",
        "multimodal",
        "other"
      ],
      "title": "Modality",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "RoutingState": {
      "enum": [
        "unassessed",
        "provisional",
        "qualified",
        "review_only",
        "quarantined",
        "stale"
      ],
      "title": "RoutingState",
      "type": "string"
    },
    "SizeFeatures": {
      "additionalProperties": false,
      "properties": {
        "input_tokens_estimate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens Estimate"
        },
        "observed_input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Input Tokens"
        },
        "entity_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Count"
        },
        "file_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Count"
        },
        "required_output_items": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Output Items"
        },
        "dependency_depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Depth"
        },
        "tool_steps_estimate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Steps Estimate"
        },
        "modality": {
          "$ref": "#/$defs/Modality",
          "default": "text"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "medium"
        },
        "source_complexity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Complexity"
        }
      },
      "title": "SizeFeatures",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "profile_key": {
      "title": "Profile Key",
      "type": "string"
    },
    "route_fingerprint": {
      "title": "Route Fingerprint",
      "type": "string"
    },
    "task_family": {
      "title": "Task Family",
      "type": "string"
    },
    "size_features": {
      "$ref": "#/$defs/SizeFeatures"
    },
    "harness_version": {
      "title": "Harness Version",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "decoding_settings": {
      "additionalProperties": true,
      "title": "Decoding Settings",
      "type": "object"
    },
    "tool_protocol": {
      "title": "Tool Protocol",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "distinct_case_count": {
      "default": 0,
      "title": "Distinct Case Count",
      "type": "integer"
    },
    "repeated_run_count": {
      "default": 0,
      "title": "Repeated Run Count",
      "type": "integer"
    },
    "pass_count": {
      "default": 0,
      "title": "Pass Count",
      "type": "integer"
    },
    "confidence_method": {
      "default": "wilson",
      "title": "Confidence Method",
      "type": "string"
    },
    "lower_bound": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lower Bound"
    },
    "routing_state": {
      "$ref": "#/$defs/RoutingState",
      "default": "unassessed"
    },
    "max_supported_features": {
      "anyOf": [
        {
          "$ref": "#/$defs/SizeFeatures"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recheck_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recheck At"
    }
  },
  "required": [
    "profile_key",
    "route_fingerprint",
    "task_family",
    "size_features",
    "harness_version",
    "prompt_version",
    "tool_protocol",
    "dataset_version"
  ],
  "title": "CapabilityProfile",
  "type": "object"
}
