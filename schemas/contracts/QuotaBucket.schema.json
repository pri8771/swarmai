    },
    "bucket_id": {
      "title": "Bucket Id",
      "type": "string"
    },
    "scope_type": {
      "title": "Scope Type",
      "type": "string"
    },
    "scope_id": {
      "title": "Scope Id",
      "type": "string"
    },
    "dimension": {
      "$ref": "#/$defs/QuotaDimension"
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit"
    },
    "remaining": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
