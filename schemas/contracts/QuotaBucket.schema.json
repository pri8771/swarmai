        "input_tokens",
        "output_tokens",
        "total_tokens",
        "uncached_tokens",
        "neurons",
        "credit",
        "concurrency"
      ],
      "title": "QuotaDimension",
      "type": "string"
    },
    "WindowType": {
      "enum": [
        "rolling",
        "fixed",
