{
  "$defs": {
    "BucketAmount": {
      "additionalProperties": false,
      "properties": {
        "bucket_id": {
          "title": "Bucket Id",
          "type": "string"
        },
        "dimension": {
          "$ref": "#/$defs/QuotaDimension"
        },
        "amount": {
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "bucket_id",
        "dimension",
        "amount"
      ],
      "title": "BucketAmount",
      "type": "object"
    },
    "QuotaDimension": {
      "enum": [
        "requests",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "uncached_tokens",
        "neurons",
        "credit",
        "concurrency"
      ],
      "title": "QuotaDimension",
      "type": "string"
    },
    "ReservationPhase": {
      "enum": [
        "reserved",
        "sending",
        "sent",
        "unknown",
        "settled"
      ],
      "title": "ReservationPhase",
      "type": "string"
    },
    "ReservationState": {
      "enum": [
        "open",
        "committed",
        "released",
        "expired",
        "unknown"
      ],
      "title": "ReservationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "reservation_id": {
      "title": "Reservation Id",
      "type": "string"
    },
    "logical_call_id": {
      "title": "Logical Call Id",
      "type": "string"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "route_id": {
      "title": "Route Id",
      "type": "string"
    },
    "bucket_amounts": {
      "items": {
        "$ref": "#/$defs/BucketAmount"
      },
      "title": "Bucket Amounts",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/ReservationState",
      "default": "open"
    },
    "phase": {
      "$ref": "#/$defs/ReservationPhase",
      "default": "reserved"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "fence_token": {
      "title": "Fence Token",
      "type": "string"
    }
  },
  "required": [
    "logical_call_id",
    "attempt_id",
    "route_id",
    "expires_at"
  ],
  "title": "Reservation",
  "type": "object"
}
